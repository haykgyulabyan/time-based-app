{% comment %}
  Time-based App - Advertisement Block

  Features:
  - Dropdown selector showing available ads from metafield
  - Preview of selected advertisement
  - Shows ad name and size in theme editor
{% endcomment %}

{% assign ad_id = block.settings.advertisement_id %}
{% assign available_ads = shop.metafields.time_based_app.advertisements.value %}

<div
  class="time-based-advertisement"
  data-ad-id="{{ ad_id }}"
  data-shop="{{ shop.permanent_domain }}"
  data-available-ads='{% if available_ads %}{{ available_ads | json }}{% else %}[]{% endif %}'
  id="time-based-ad-{{ block.id }}"
>
  {% if ad_id == blank %}
    {%- comment -%} No ad selected - show selector UI {%- endcomment -%}
    <div class="time-based-ad-selector">
      <div class="time-based-ad-selector__header">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-right: 8px;">
          <rect x="4" y="4" width="16" height="16" rx="2" stroke="#6b7280" stroke-width="2"/>
          <line x1="8" y1="9" x2="16" y2="9" stroke="#6b7280" stroke-width="2" stroke-linecap="round"/>
          <line x1="8" y1="13" x2="16" y2="13" stroke="#6b7280" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span>Select an Advertisement</span>
      </div>

      {% if available_ads and available_ads.size > 0 %}
        <p class="time-based-ad-selector__hint">Click the ID field to select it, then copy (Ctrl+C / Cmd+C) and paste into the settings panel.</p>
        <div class="time-based-ad-selector__list">
          {% for ad in available_ads %}
            <div class="time-based-ad-selector__item" data-ad-id="{{ ad.id }}">
              <div class="time-based-ad-selector__item-info">
                <span class="time-based-ad-selector__item-name">{{ ad.name }}</span>
                <span class="time-based-ad-selector__item-size">{{ ad.size }}</span>
              </div>
              <div class="time-based-ad-selector__item-id">
                <span>ID:</span>
                <input type="text" class="time-based-ad-selector__id-input" value="{{ ad.id }}" readonly onclick="this.select();">
              </div>
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="time-based-ad-selector__empty">
          <p>No advertisements available.</p>
          <p class="time-based-ad-selector__empty-hint">Create advertisements in the Time-based App admin panel, then refresh this page.</p>
        </div>
      {% endif %}
    </div>
  {% else %}
    {%- comment -%} Ad selected - show loading state, JS will render preview {%- endcomment -%}
    <div class="time-based-ad-preview" data-ad-id="{{ ad_id }}">
      <div class="time-based-ad-preview__loading">
        <div class="time-based-ad-preview__spinner"></div>
        <span>Loading advertisement #{{ ad_id }}...</span>
      </div>
    </div>
  {% endif %}
</div>

{{ 'advertisement.css' | asset_url | stylesheet_tag }}
<script src="{{ 'advertisement.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Time-Based Ad",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "advertisement_id",
      "label": "Advertisement ID",
      "info": "Enter the ID of the advertisement. Click on an ad in the preview to copy its ID."
    }
  ]
}
{% endschema %}
