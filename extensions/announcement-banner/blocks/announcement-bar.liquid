{% comment %}
  Time-based App - Announcement Bars & Slider Banners

  Announcement bars appear automatically at the top of the page.

  For slider banners, add this div to your theme where you want the slider to appear:
  <div id="time-based-slider-placeholder"></div>

  Scheduling is checked client-side using UTC time.
{% endcomment %}

<div id="time-based-app-banners" data-shop="{{ shop.permanent_domain }}"></div>

{{ 'announcement-bar.css' | asset_url | stylesheet_tag }}
{{ 'slider-banner.css' | asset_url | stylesheet_tag }}

<script src="{{ 'announcement-bar.js' | asset_url }}" defer></script>
<script src="{{ 'slider-banner.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Time-based Content",
  "target": "body",
  "stylesheet": "announcement-bar.css",
  "javascript": "announcement-bar.js",
  "settings": [
    {
      "type": "paragraph",
      "content": "Enables announcement bars and slider banners. Configure content in the Time-based App admin panel."
    },
    {
      "type": "paragraph",
      "content": "For sliders: Add <div id=\"time-based-slider-placeholder\"></div> to your theme where you want the slider to appear."
    }
  ]
}
{% endschema %}
