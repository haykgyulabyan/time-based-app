{
  "version": 2,
  "framework": null,
  "installCommand": "npm install --workspaces --include-workspace-root",
  "buildCommand": "npm run build --workspace=web/frontend",
  "outputDirectory": ".",
  "builds": [
    {
      "src": "web/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["web/frontend/dist/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/web/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}